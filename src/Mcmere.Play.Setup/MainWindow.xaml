<Window x:Class="Mcmere.Play.Setup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="mcmere Play セットアップ" Icon="Assets/mcmere.ico" Width="740" Height="680" MinWidth="700" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F7F8FA" Foreground="#202124" FontFamily="Segoe UI, Yu Gothic UI" Loaded="OnLoaded">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#E6E8EC"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".9"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid x:Name="RootSurface" Margin="36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,30"><Image Source="Assets/mcmere.png" Width="58" Height="58" Margin="0,0,17,0"/>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="mcmere Play" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="サーバーに合う環境を、準備して参加。" FontSize="13" Foreground="#666D77" Margin="0,5,0,0"/></StackPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Background="White" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="12" Padding="23"><StackPanel>
    <TextBlock Text="このPCにインストール" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="アプリとプレイ環境を専用フォルダーに用意します。" Foreground="#666D77" FontSize="13" Margin="0,10,0,20"/>
    <TextBlock Text="保存先" FontSize="12" Foreground="#666D77"/>
    <DockPanel Margin="0,8,0,18"><Button Content="変更" DockPanel.Dock="Right" Click="Choose_Click"/><TextBox x:Name="RootPath" VerticalContentAlignment="Center" Padding="9" IsReadOnly="True" BorderBrush="#E6E8EC" BorderThickness="1"/></DockPanel>
    <TextBlock Text="更新時も、ゲームデータ・設定・アカウント情報を保持します。" FontSize="13" Foreground="#28784D"/>
   </StackPanel></Border>
   <TextBlock x:Name="Prerequisite" Margin="0,20,0,10" FontSize="13" Foreground="#666D77"/>
   <Expander Header="詳細ログ" FontSize="12"><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Expander>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,22,0,0">
   <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#0865DC"/>
   <TextBlock x:Name="Status" Text="インストールの準備ができました" FontSize="14" Margin="0,14,0,8"/>
   <TextBlock Text="Minecraft本体とMODは、アプリで環境を準備するときに取得します。" FontSize="12" Foreground="#666D77" Margin="0,0,0,18"/>
   <DockPanel><Button Content="MIT License" DockPanel.Dock="Left" Background="Transparent" Margin="0" Padding="0,8" Click="License_Click"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CloseButton" Content="閉じる" Click="Close_Click"/><Button x:Name="OpenButton" Content="mcmere Playを開く" Click="Open_Click" Visibility="Collapsed" Background="#0865DC" Foreground="White"/><Button x:Name="InstallButton" Content="インストール" Click="Install_Click" Background="#0865DC" Foreground="White"/></StackPanel>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>
